# OpenAI API Key (นำมาจาก https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# โมเดลเริ่มต้นที่ต้องการใช้งาน (เช่น gpt-4o-mini, gpt-4o)
OPENAI_MODEL=gpt-4o-mini

# การตั้งค่าเซิร์ฟเวอร์
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (คั่นด้วยจุลภาค เช่น http://localhost:3000,http://localhost:5173 หรือ * สำหรับทุกโดเมน)
ALLOWED_ORIGINS=*
